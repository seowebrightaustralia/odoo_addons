<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_search_sh_names_new" model="ir.ui.view">
        <field name="name">crm.lead.search.sh.names.new</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            
            <!-- Finds the Customer search field and adds your custom options right below it -->
            <xpath expr="//field[@name='partner_id']" position="after">
                
                <!-- Adds "Search First Name for: " -->
                <field name="partner_id" 
                       string="First Name" 
                       filter_domain="[('partner_id.sh_firstname', 'ilike', self)]"/>
                       
                <!-- Adds "Search Last Name for: " -->
                <field name="partner_id" 
                       string="Last Name" 
                       filter_domain="[('partner_id.sh_lastname', 'ilike', self)]"/>
                       
            </xpath>
            
        </field>
    </record>
</odoo>