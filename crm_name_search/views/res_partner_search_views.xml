<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_search_sh_names" model="ir.ui.view">
        <field name="name">res.partner.search.sh.names</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            
            <xpath expr="//search" position="inside">
                
                <field name="sh_firstname" 
                       string="Search First OR Last Name" 
                       filter_domain="['|', ('sh_firstname', 'ilike', self), ('sh_lastname', 'ilike', self)]"/>
                       
            </xpath>
            
        </field>
    </record>
</odoo>