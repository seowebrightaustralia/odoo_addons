<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search view: adds "Products Quoted" as a direct search field -->
    <record id="view_crm_opportunity_search_products_quoted" model="ir.ui.view">
        <field name="name">crm.lead.search.products.quoted</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sh_products_search" string="Products Quoted"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_search_products_quoted" model="ir.ui.view">
        <field name="name">crm.lead.search.leads.products.quoted</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sh_products_search" string="Products Quoted"/>
            </xpath>
        </field>
    </record>

    <!-- Form view: Products Quoted tab -->
    <record id="view_crm_lead_form_products_quoted" model="ir.ui.view">
        <field name="name">crm.lead.form.products.quoted</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='lead']" position="after">
                <page string="Products Quoted" name="products_quoted">
                    <field name="product_line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
